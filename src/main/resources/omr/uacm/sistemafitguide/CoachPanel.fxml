<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="omr.uacm.sistemafitguide.CoachPanelController"
            style="-fx-background-color: #eef2f6; -fx-font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;">

    <top>
        <VBox style="-fx-background-color: linear-gradient(to bottom, #1a3c3c, #0f2a2a); -fx-background-radius: 0 0 20 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 12, 0, 0, 4);">
            <padding>
                <Insets top="16" right="24" bottom="20" left="24"/>
            </padding>

            <!-- Fila 1: ícono + saludo + [BOTÓN EJERCICIOS] + cerrar sesión -->
            <HBox alignment="CENTER_LEFT" spacing="12">

                <!-- Ícono de usuario -->
                <StackPane style="-fx-background-color: #2a5555; -fx-background-radius: 50%;
                                  -fx-min-width: 36; -fx-min-height: 36;
                                  -fx-max-width: 36; -fx-max-height: 36;
                                  -fx-alignment: center;">
                    <Label text="" style="-fx-font-size: 16px;"/>
                </StackPane>

                <!-- Saludo -->
                <Label fx:id="LblTituloCoach" text="¡Hola, Coach!"
                       style="-fx-text-fill: #ffffff; -fx-font-size: 22px; -fx-font-weight: bold;"/>

                <!-- Empuja el botón de ejercicios al centro-izquierda -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- ══ BOTÓN IR A EJERCICIOS (superior izquierdo relativo al centro) ══ -->
                <Button fx:id="BtnIrEjercicios"
                        text="  Ver Ejercicios"
                        onMouseClicked="#HandleIrEjercicios"
                        style="-fx-background-color: #2a7a6a;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 20;
                               -fx-padding: 8 18 8 18;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.2),4,0,0,2);"/>

                <!-- Separador visual pequeño -->
                <Region prefWidth="8"/>

                <!-- Cerrar sesión -->
                <Button fx:id="BtnCerrarSesion"
                        text=" Cerrar Sesión"
                        onMouseClicked="#HandleCerrarSesion"
                        style="-fx-background-color: transparent;
                               -fx-border-color: #4ecdc4;
                               -fx-border-radius: 20;
                               -fx-background-radius: 20;
                               -fx-text-fill: #4ecdc4;
                               -fx-font-size: 13px;
                               -fx-padding: 8 16 8 16;
                               -fx-cursor: hand;"/>
            </HBox>

            <!-- Stats row -->
            <HBox spacing="16" style="-fx-alignment: center-left;">
                <padding>
                    <Insets top="18" right="0" bottom="0" left="0"/>
                </padding>

                <!-- Ejercicios Disponibles -->
                <HBox spacing="12" alignment="CENTER_LEFT"
                      style="-fx-background-color: rgba(255,255,255,0.08);
                             -fx-background-radius: 14;
                             -fx-border-color: rgba(78,205,196,0.25);
                             -fx-border-radius: 14; -fx-border-width: 1;"
                      HBox.hgrow="ALWAYS">
                    <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>
                    <Label text="" style="-fx-font-size: 22px; -fx-text-fill: #4ecdc4;"/>
                    <VBox spacing="2">
                        <Label fx:id="LblNumEjercicios" text="—"
                               style="-fx-text-fill: #ffffff; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                        <Label text="Ejercicios disponibles"
                               style="-fx-text-fill: #a0c4c4; -fx-font-size: 12px;"/>
                    </VBox>
                </HBox>

                <!-- Usuarios Activos -->
                <HBox spacing="12" alignment="CENTER_LEFT"
                      style="-fx-background-color: rgba(255,255,255,0.08);
                             -fx-background-radius: 14;
                             -fx-border-color: rgba(78,205,196,0.25);
                             -fx-border-radius: 14; -fx-border-width: 1;"
                      HBox.hgrow="ALWAYS">
                    <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>
                    <Label text="" style="-fx-font-size: 22px; -fx-text-fill: #4ecdc4;"/>
                    <VBox spacing="2">
                        <Label fx:id="LblNumUsuarios" text="—"
                               style="-fx-text-fill: #ffffff; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                        <Label text="Usuarios activos"
                               style="-fx-text-fill: #a0c4c4; -fx-font-size: 12px;"/>
                    </VBox>
                </HBox>

                <!-- Sesiones esta semana -->
                <HBox spacing="12" alignment="CENTER_LEFT"
                      style="-fx-background-color: rgba(255,255,255,0.08);
                             -fx-background-radius: 14;
                             -fx-border-color: rgba(78,205,196,0.25);
                             -fx-border-radius: 14; -fx-border-width: 1;"
                      HBox.hgrow="ALWAYS">
                    <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>
                    <Label text="" style="-fx-font-size: 22px; -fx-text-fill: #4ecdc4;"/>
                    <VBox spacing="2">
                        <Label fx:id="LblNumSesiones" text="—"
                               style="-fx-text-fill: #ffffff; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                        <Label text="Sesiones de usuarios"
                               style="-fx-text-fill: #a0c4c4; -fx-font-size: 12px;"/>
                    </VBox>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- ========== CONTENIDO PRINCIPAL ========== -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;
                           -fx-border-color: transparent; -fx-padding: 0;"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <HBox spacing="20" style="-fx-background-color: transparent;">
                <padding>
                    <Insets top="20" right="24" bottom="24" left="24"/>
                </padding>

                <!-- ===== COLUMNA IZQUIERDA ===== -->
                <VBox spacing="16" minWidth="260" prefWidth="280" maxWidth="320">

                    <!-- Esta semana (calendario) -->
                    <VBox spacing="12"
                          style="-fx-background-color: #ffffff; -fx-background-radius: 16;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,2);">
                        <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="" style="-fx-font-size: 16px;"/>
                            <Label text="Esta semana"
                                   style="-fx-text-fill: #1a2e2e; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                        </HBox>
                        <HBox spacing="4" alignment="CENTER">
                            <VBox alignment="CENTER" spacing="4" style="-fx-min-width: 28; -fx-pref-width: 28;">
                                <Label text="L" style="-fx-text-fill: #8a9a9a; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                                <StackPane style="-fx-background-color: #f0f4f4; -fx-background-radius: 50%; -fx-min-width: 28; -fx-min-height: 28; -fx-max-width: 28; -fx-max-height: 28; -fx-alignment: center;">
                                    <Label text="21" style="-fx-text-fill: #5a6a6a; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                </StackPane>
                            </VBox>
                            <VBox alignment="CENTER" spacing="4" style="-fx-min-width: 28; -fx-pref-width: 28;">
                                <Label text="M" style="-fx-text-fill: #8a9a9a; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                                <StackPane style="-fx-background-color: #f0f4f4; -fx-background-radius: 50%; -fx-min-width: 28; -fx-min-height: 28; -fx-max-width: 28; -fx-max-height: 28; -fx-alignment: center;">
                                    <Label text="22" style="-fx-text-fill: #5a6a6a; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                </StackPane>
                            </VBox>
                            <VBox alignment="CENTER" spacing="4" style="-fx-min-width: 28; -fx-pref-width: 28;">
                                <Label text="M" style="-fx-text-fill: #8a9a9a; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                                <StackPane style="-fx-background-color: #f0f4f4; -fx-background-radius: 50%; -fx-min-width: 28; -fx-min-height: 28; -fx-max-width: 28; -fx-max-height: 28; -fx-alignment: center;">
                                    <Label text="23" style="-fx-text-fill: #5a6a6a; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                </StackPane>
                            </VBox>
                            <VBox alignment="CENTER" spacing="4" style="-fx-min-width: 28; -fx-pref-width: 28;">
                                <Label text="J" style="-fx-text-fill: #1a3c3c; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                                <StackPane style="-fx-background-color: #1a3c3c; -fx-background-radius: 50%; -fx-min-width: 28; -fx-min-height: 28; -fx-max-width: 28; -fx-max-height: 28; -fx-alignment: center;">
                                    <Label text="24" style="-fx-text-fill: #ffffff; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                </StackPane>
                            </VBox>
                            <VBox alignment="CENTER" spacing="4" style="-fx-min-width: 28; -fx-pref-width: 28;">
                                <Label text="V" style="-fx-text-fill: #8a9a9a; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                                <StackPane style="-fx-background-color: #f0f4f4; -fx-background-radius: 50%; -fx-min-width: 28; -fx-min-height: 28; -fx-max-width: 28; -fx-max-height: 28; -fx-alignment: center;">
                                    <Label text="25" style="-fx-text-fill: #5a6a6a; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                </StackPane>
                            </VBox>
                            <VBox alignment="CENTER" spacing="4" style="-fx-min-width: 28; -fx-pref-width: 28;">
                                <Label text="S" style="-fx-text-fill: #8a9a9a; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                                <StackPane style="-fx-background-color: #f0f4f4; -fx-background-radius: 50%; -fx-min-width: 28; -fx-min-height: 28; -fx-max-width: 28; -fx-max-height: 28; -fx-alignment: center;">
                                    <Label text="26" style="-fx-text-fill: #5a6a6a; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                </StackPane>
                            </VBox>
                            <VBox alignment="CENTER" spacing="4" style="-fx-min-width: 28; -fx-pref-width: 28;">
                                <Label text="D" style="-fx-text-fill: #8a9a9a; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                                <StackPane style="-fx-background-color: #f0f4f4; -fx-background-radius: 50%; -fx-min-width: 28; -fx-min-height: 28; -fx-max-width: 28; -fx-max-height: 28; -fx-alignment: center;">
                                    <Label text="27" style="-fx-text-fill: #5a6a6a; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                </StackPane>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Consejo del día -->
                    <VBox spacing="10"
                          style="-fx-background-color: linear-gradient(to bottom right, #1a3c3c, #0d2828);
                                 -fx-background-radius: 16;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.2),12,0,0,3);">
                        <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="" style="-fx-font-size: 16px;"/>
                            <Label text="Consejo del día"
                                   style="-fx-text-fill: #4ecdc4; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        </HBox>
                        <Label fx:id="LblConsejoDia"
                               text="&quot;El progreso no siempre se trata de hacer más, sino de ser más constante.&quot;"
                               style="-fx-text-fill: #e0f0f0; -fx-font-size: 13px;
                                      -fx-font-style: italic; -fx-line-spacing: 2;"
                               wrapText="true"/>
                    </VBox>

                    <!-- Panel del Coach (menú) -->
                    <VBox spacing="8"
                          style="-fx-background-color: #ffffff; -fx-background-radius: 16;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,2);">
                        <padding><Insets top="16" right="12" bottom="12" left="12"/></padding>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <padding><Insets bottom="4"/></padding>
                            <Label text="" style="-fx-font-size: 16px;"/>
                            <Label text="Panel del Coach"
                                   style="-fx-text-fill: #1a2e2e; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                        </HBox>

                        <HBox fx:id="BtnAgregarEjercicios" alignment="CENTER_LEFT" spacing="12"
                              onMouseClicked="#HandleAgregarEjercicios"
                              style="-fx-background-color: #f4f8f8; -fx-background-radius: 12; -fx-cursor: hand;">
                            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                            <Label text="" style="-fx-font-size: 16px;"/>
                            <Label text="Agregar ejercicios"
                                   style="-fx-text-fill: #2a3e3e; -fx-font-size: 13px; -fx-font-weight: bold;"
                                   HBox.hgrow="ALWAYS"/>
                            <Label text="" style="-fx-text-fill: #8a9a9a; -fx-font-size: 18px;"/>
                        </HBox>

                        <HBox fx:id="BtnRevisarUsuarios" alignment="CENTER_LEFT" spacing="12"
                              onMouseClicked="#HandleRevisarUsuarios"
                              style="-fx-background-color: #f4f8f8; -fx-background-radius: 12; -fx-cursor: hand;">
                            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                            <Label text="" style="-fx-font-size: 16px;"/>
                            <Label text="Revisar usuarios"
                                   style="-fx-text-fill: #2a3e3e; -fx-font-size: 13px; -fx-font-weight: bold;"
                                   HBox.hgrow="ALWAYS"/>
                            <Label text="" style="-fx-text-fill: #8a9a9a; -fx-font-size: 18px;"/>
                        </HBox>

                        <HBox fx:id="BtnVerEstadisticas" alignment="CENTER_LEFT" spacing="12"
                              onMouseClicked="#HandleVerEstadisticas"
                              style="-fx-background-color: #f4f8f8; -fx-background-radius: 12; -fx-cursor: hand;">
                            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                            <Label text="" style="-fx-font-size: 16px;"/>
                            <Label text="Ver estadísticas"
                                   style="-fx-text-fill: #2a3e3e; -fx-font-size: 13px; -fx-font-weight: bold;"
                                   HBox.hgrow="ALWAYS"/>
                            <Label text="" style="-fx-text-fill: #8a9a9a; -fx-font-size: 18px;"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- ===== COLUMNA DERECHA: Consejos del Coach ===== -->
                <VBox spacing="12" HBox.hgrow="ALWAYS">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="" style="-fx-font-size: 16px;"/>
                        <VBox spacing="2">
                            <Label text="Consejos del Coach"
                                   style="-fx-text-fill: #1a2e2e; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                            <Label text="Toca una tarjeta para ver el consejo completo"
                                   style="-fx-text-fill: #7a8a8a; -fx-font-size: 12px;"/>
                        </VBox>
                    </HBox>

                    <!-- Grid 2x3 de consejos -->
                    <GridPane hgap="14" vgap="14" style="-fx-padding: 4 0 0 0;">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints vgrow="ALWAYS"/>
                            <RowConstraints vgrow="ALWAYS"/>
                            <RowConstraints vgrow="ALWAYS"/>
                        </rowConstraints>

                        <!-- 1. Entrenamiento -->
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0"
                              style="-fx-background-color: #ffffff; -fx-background-radius: 16;
                                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,2);
                                     -fx-cursor: hand; -fx-min-height: 140;">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <StackPane style="-fx-background-color: #e0f7f5; -fx-background-radius: 50%; -fx-min-width: 36; -fx-min-height: 36; -fx-max-width: 36; -fx-max-height: 36; -fx-alignment: center;">
                                    <Label text="" style="-fx-font-size: 16px;"/>
                                </StackPane>
                                <Label text="Entrenamiento" style="-fx-background-color: #d0f5f0; -fx-text-fill: #0d8a7a; -fx-background-radius: 10; -fx-padding: 3 10 3 10; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="›" style="-fx-text-fill: #b0c0c0; -fx-font-size: 16px;"/>
                            </HBox>
                            <Label text="Técnica sobre intensidad"
                                   style="-fx-text-fill: #1a2e2e; -fx-font-size: 14px; -fx-font-weight: bold;" wrapText="true"/>
                            <Label text="La intensidad adecuada mejora los resultados y reduce el riesgo de lesiones. Enfócate en la calidad, no solo en la cantidad."
                                   style="-fx-text-fill: #6a7a7a; -fx-font-size: 12px; -fx-line-spacing: 1;" wrapText="true"/>
                        </VBox>

                        <!-- 2. Nutrición -->
                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0"
                              style="-fx-background-color: #ffffff; -fx-background-radius: 16;
                                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,2);
                                     -fx-cursor: hand; -fx-min-height: 140;">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <StackPane style="-fx-background-color: #f0e8ff; -fx-background-radius: 50%; -fx-min-width: 36; -fx-min-height: 36; -fx-max-width: 36; -fx-max-height: 36; -fx-alignment: center;">
                                    <Label text="" style="-fx-font-size: 16px;"/>
                                </StackPane>
                                <Label text="Nutrición" style="-fx-background-color: #ebe0ff; -fx-text-fill: #6b3fa0; -fx-background-radius: 10; -fx-padding: 3 10 3 10; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="" style="-fx-text-fill: #b0c0c0; -fx-font-size: 16px;"/>
                            </HBox>
                            <Label text="Hidratación constante"
                                   style="-fx-text-fill: #1a2e2e; -fx-font-size: 14px; -fx-font-weight: bold;" wrapText="true"/>
                            <Label text="Mantenerte hidratado mejora tu rendimiento, concentración y recuperación. Lleva siempre tu botella de agua."
                                   style="-fx-text-fill: #6a7a7a; -fx-font-size: 12px; -fx-line-spacing: 1;" wrapText="true"/>
                        </VBox>

                        <!-- 3. Mentalidad -->
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1"
                              style="-fx-background-color: #ffffff; -fx-background-radius: 16;
                                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,2);
                                     -fx-cursor: hand; -fx-min-height: 140;">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <StackPane style="-fx-background-color: #e0f0ff; -fx-background-radius: 50%; -fx-min-width: 36; -fx-min-height: 36; -fx-max-width: 36; -fx-max-height: 36; -fx-alignment: center;">
                                    <Label text="" style="-fx-font-size: 16px;"/>
                                </StackPane>
                                <Label text="Mentalidad" style="-fx-background-color: #d0e8ff; -fx-text-fill: #1a6bb5; -fx-background-radius: 10; -fx-padding: 3 10 3 10; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="" style="-fx-text-fill: #b0c0c0; -fx-font-size: 16px;"/>
                            </HBox>
                            <Label text="La constancia gana"
                                   style="-fx-text-fill: #1a2e2e; -fx-font-size: 14px; -fx-font-weight: bold;" wrapText="true"/>
                            <Label text="No necesitas ser perfecto, solo constante. Cada pequeño esfuerzo cuenta y te acerca a tus objetivos."
                                   style="-fx-text-fill: #6a7a7a; -fx-font-size: 12px; -fx-line-spacing: 1;" wrapText="true"/>
                        </VBox>

                        <!-- 4. Rendimiento -->
                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1"
                              style="-fx-background-color: #ffffff; -fx-background-radius: 16;
                                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,2);
                                     -fx-cursor: hand; -fx-min-height: 140;">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <StackPane style="-fx-background-color: #fff0e0; -fx-background-radius: 50%; -fx-min-width: 36; -fx-min-height: 36; -fx-max-width: 36; -fx-max-height: 36; -fx-alignment: center;">
                                    <Label text="" style="-fx-font-size: 16px;"/>
                                </StackPane>
                                <Label text="Rendimiento" style="-fx-background-color: #ffe8d0; -fx-text-fill: #c06020; -fx-background-radius: 10; -fx-padding: 3 10 3 10; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="›" style="-fx-text-fill: #b0c0c0; -fx-font-size: 16px;"/>
                            </HBox>
                            <Label text="Descanso también es progreso"
                                   style="-fx-text-fill: #1a2e2e; -fx-font-size: 14px; -fx-font-weight: bold;" wrapText="true"/>
                            <Label text="Tu cuerpo se fortalece cuando descansa. Un buen descanso mejora tu rendimiento y previene lesiones."
                                   style="-fx-text-fill: #6a7a7a; -fx-font-size: 12px; -fx-line-spacing: 1;" wrapText="true"/>
                        </VBox>

                        <!-- 5. Hábitos -->
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="2"
                              style="-fx-background-color: #ffffff; -fx-background-radius: 16;
                                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,2);
                                     -fx-cursor: hand; -fx-min-height: 140;">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <StackPane style="-fx-background-color: #e0f7e8; -fx-background-radius: 50%; -fx-min-width: 36; -fx-min-height: 36; -fx-max-width: 36; -fx-max-height: 36; -fx-alignment: center;">
